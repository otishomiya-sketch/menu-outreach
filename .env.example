# cp .env.example .env して値を入れる。.env は人に渡さない・チャットに貼らない

# ① 店舗収集（Googleマップ）/ Instagram解析の予備手段
APIFY_API_TOKEN=

# ② Instagram 解析（公式・推奨）Business Discovery API
#   Facebookログイン方式（Facebookページに紐づけたプロアカウント）で取得した値が必要。
#   insta-autopost-kit の「Instagram業務用ログイン」のトークンでは動きません。
#   空なら Apify で代用します。
IG_BD_USER_ID=
IG_BD_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# ③ メール送信（SMTP / SSL）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 返信の取り込み（空なら SMTP と同じユーザー・パスワード）
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# IMAP が使えないメール（ヘテムル等）は POP3。メールはサーバーから削除しません
POP3_HOST=
POP3_PORT=995

# ④ 任意: 写真のAI採点（use_vision: true）と文面の自動提案
ANTHROPIC_API_KEY=
